{
  "model": {
    "model_type": "diffusion",
    "unet": {
      "unet_impl": "efficient_nd",
      "spatial_dims": 2,
      "in_channels": 1,
      "out_channels": 1,
      "model_channels": 128,
      "num_res_blocks": 2,
      "channel_mult": [
        1,
        2,
        4,
        4
      ],
      "attention_resolutions": [
        32,
        16
      ],
      "use_self_attention": true,
      "use_cross_attention": true,
      "context_dim": 1,
      "dropout": 0.0
    },
    "scheduler": {
      "name": "ddpm",
      "num_train_timesteps": 1000,
      "num_inference_steps": 50,
      "beta_schedule": "linear"
    }
  },
  "training": {
    "epochs": 200,
    "batch_size": 4,
    "learning_rate": 0.0001,
    "conditioning": "attention",
    "use_amp": true,
    "seed": 42,
    "save_every": 10,
    "output_dir": "checkpoints/pixel_ddpm_attn",
    "data_root": "../DefaultDataset"
  },
  "dataset": {
    "conditioning": true,
    "target_key": "SDCT",
    "conditioning_key": "LDCT",
    "class": "datasets.ldct:LDCTAttentionDataset"
  }
}
