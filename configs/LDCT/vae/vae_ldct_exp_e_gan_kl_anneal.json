{
  "model": {
    "model_type": "vae",
    "latent_type": "kl",
    "in_channels": 1,
    "out_channels": 1,
    "resolution": 256,
    "base_ch": 128,
    "ch_mult": [
      1,
      2,
      4,
      4
    ],
    "num_res_blocks": 2,
    "attn_resolutions": [],
    "use_attention": true,
    "z_channels": 4,
    "embed_dim": 4,
    "double_z": true,
    "spatial_dims": 2,
    "attention_impl": "spatial",
    "attn_heads": 4
  },
  "training": {
    "epochs": 300,
    "batch_size": 32,
    "learning_rate": 0.0001,
    "weight_decay": 0.0,
    "recon_type": "bce_focal",
    "kl_weight": 5e-05,
    "kl_anneal_steps": 200000,
    "perceptual_weight": 0.0,
    "gan_weight": 0.5,
    "gan_start": 70,
    "use_amp": false,
    "seed": 42,
    "save_every": 10,
    "output_dir": "checkpoints/vae_ldct_exp_e_gan_kl_anneal",
    "data_root": "../DefaultDataset",
    "use_tensor_cache": true,
    "save_tensor_cache": true,
    "tensor_cache_subdir": "cache"
  },
  "dataset": {
    "conditioning": true,
    "conditioning_fallback_key": "SDCT",
    "target_key": "SDCT",
    "conditioning_key": "LDCT",
    "class": "datasets.ldct:LDCTDataset"
  }
}
