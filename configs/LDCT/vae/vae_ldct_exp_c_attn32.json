{
  "model": {
    "model_type": "vae",
    "latent_type": "kl",
    "in_channels": 1,
    "out_channels": 1,
    "resolution": 256,
    "base_ch": 128,
    "ch_mult": [
      1,
      2,
      4,
      4
    ],
    "num_res_blocks": 2,
    "attn_resolutions": [
      32
    ],
    "use_attention": true,
    "z_channels": 4,
    "embed_dim": 4,
    "double_z": true,
    "spatial_dims": 2,
    "attention_impl": "spatial",
    "zero_init_attn_out": true
  },
  "training": {
    "epochs": 100,
    "batch_size": 32,
    "learning_rate": 1e-05,
    "weight_decay": 0.0,
    "recon_type": "bce_focal",
    "kl_weight": 5e-05,
    "perceptual_weight": 0.1,
    "use_amp": false,
    "seed": 42,
    "save_every": 10,
    "output_dir": "checkpoints/vae_ldct_exp_c_attn32",
    "data_root": "../DefaultDataset",
    "use_tensor_cache": true,
    "save_tensor_cache": true,
    "tensor_cache_subdir": "cache",
    "input_normalize": "positive",
    "lr_scheduler": {
      "name": "cosineannealinglr"
    }
  },
  "dataset": {
    "conditioning": true,
    "conditioning_fallback_key": "SDCT",
    "target_key": "SDCT",
    "conditioning_key": "LDCT",
    "class": "datasets.ldct:LDCTDataset"
  }
}
