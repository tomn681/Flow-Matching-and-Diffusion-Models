{
  "model": {
    "model_type": "vae",
    "latent_type": "kl",
    "in_channels": 1,
    "out_channels": 1,
    "resolution": 256,
    "base_ch": 128,
    "ch_mult": [
      1,
      2,
      4,
      4
    ],
    "num_res_blocks": 2,
    "attn_resolutions": [],
    "use_attention": true,
    "z_channels": 4,
    "embed_dim": 4,
    "double_z": true,
    "spatial_dims": 2,
    "attention_impl": "spatial"
  },
  "training": {
    "epochs": 200,
    "batch_size": 4,
    "learning_rate": 4.5e-06,
    "weight_decay": 0.0,
    "recon_type": "bce_focal",
    "kl_weight": 1e-06,
    "use_amp": true,
    "seed": 42,
    "save_every": 10,
    "output_dir": "checkpoints/vae_sd_kl_bce_focal",
    "data_root": "../DefaultDataset"
  },
  "dataset": {
    "conditioning": true,
    "conditioning_fallback_key": "SDCT",
    "target_key": "SDCT",
    "conditioning_key": "LDCT"
  }
}
