{
  "training": {
    "output_dir": "checkpoints/mnist_magvit_tokenizer",
    "epochs": 15,
    "batch_size": 128,
    "num_workers": 4,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "reg_type": "vq",
    "recon_type": "bce",
    "perceptual_weight": 0.0,
    "gan_weight": 0.0,
    "gan_start": 0,
    "disc_lr": null,
    "manual_device": null,
    "perceptual_device": null,
    "disc_device": null,
    "allow_microbatching": true,
    "use_amp": false,
    "save_every": 5,
    "seed": 42,
    "img_size": 32,
    "data_root": "data/mnist",
    "download": true,
    "codebook_weight": 1.0,
    "save_images": true,
    "save_images_every": 1,
    "use_tensor_cache": true,
    "save_tensor_cache": false,
    "tensor_cache_subdir": "cache"
  },
  "model": {
    "in_channels": 1,
    "out_channels": 1,
    "resolution": 32,
    "base_ch": 64,
    "down_channels": [
      64,
      128,
      256
    ],
    "num_res_blocks": 2,
    "attn_resolutions": [],
    "z_channels": 64,
    "embed_dim": 64,
    "dropout": 0.0,
    "use_attention": false,
    "spatial_dims": 2,
    "emb_channels": null,
    "use_scale_shift_norm": false,
    "attn_heads": 1,
    "attn_dim_head": 512,
    "latent_type": "vq",
    "codebook_size": 512,
    "vq_beta": 0.25,
    "vq_ema_decay": 0.99,
    "vq_ema_eps": 1e-05,
    "norm_type": "gn",
    "act": "silu",
    "ckpt_path": null,
    "model_type": "vae",
    "quantizer_type": "ema",
    "discriminator_type": "magvit",
    "norm_eps": 1e-06,
    "zero_init_last_conv": false,
    "zero_init_attn_out": true,
    "attention_impl": "compvis",
    "use_asymmetric_padding_downsample": true
  },
  "dataset": {
    "class": "datasets.mnist:MNISTDataset"
  }
}
