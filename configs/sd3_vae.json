{
  "training": {
    "epochs": 100,
    "batch_size": 8,
    "learning_rate": 1e-05,
    "weight_decay": 0.0,
    "num_workers": 4,
    "manual_device": "cuda",
    "output_dir": "checkpoints/sd3_vae",
    "save_every": 5,
    "validate": true,
    "save_images_every": 5,
    "use_amp": false,
    "seed": 42,
    "loss": "l1",
    "kl_weight": 5e-05,
    "perceptual_weight": 0.1,
    "scheduler": {
      "name": "cosineannealinglr",
      "params": {
        "T_max": 100
      }
    }
  },
  "model": {
    "model_type": "vae",
    "latent_type": "kl",
    "in_channels": 1,
    "out_channels": 1,
    "resolution": 256,
    "base_ch": 128,
    "ch_mult": [
      1,
      2,
      4,
      4
    ],
    "num_res_blocks": {
      "encoder": 2,
      "decoder": 3
    },
    "attn_resolutions": [
      32
    ],
    "z_channels": 4,
    "embed_dim": 4,
    "dropout": 0.0,
    "use_attention": true,
    "attn_heads": 1,
    "spatial_dims": 2,
    "double_z": true,
    "attention_impl": "spatial",
    "zero_init_attn_out": true
  }
}
