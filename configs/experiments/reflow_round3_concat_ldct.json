{
  "model": {
    "model_type": "reflow",
    "unet": {
      "unet_impl": "efficient_nd",
      "spatial_dims": 2,
      "in_channels": 1,
      "out_channels": 1,
      "model_channels": 128,
      "num_res_blocks": 2,
      "channel_mult": [
        1,
        2,
        4,
        4
      ],
      "attention_resolutions": [
        4,
        8
      ],
      "dropout": 0.0
    },
    "scheduler": {
      "name": "flow_match_euler",
      "num_train_timesteps": 1000,
      "num_inference_steps": 1
    }
  },
  "training": {
    "epochs": 100,
    "batch_size": 16,
    "learning_rate": 0.0001,
    "conditioning": "concatenate",
    "reflow_pairs_dir": "checkpoints/reflow_r2_concat/reflow_pairs",
    "use_amp": false,
    "seed": 42,
    "save_every": 1,
    "steps_per_epoch": 3125,
    "output_dir": "checkpoints/reflow_r3_concat",
    "data_root": "../DefaultDataset",
    "img_size": 256,
    "use_tensor_cache": true,
    "save_tensor_cache": true,
    "tensor_cache_subdir": "cache",
    "save_images": true,
    "save_images_every": 5,
    "conditioning_dropout": 0.0
  },
  "dataset": {
    "conditioning": true,
    "target_key": "SDCT",
    "conditioning_key": "LDCT",
    "class": "datasets.ldct:LDCTDataset"
  }
}
