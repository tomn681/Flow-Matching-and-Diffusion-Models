{
  "model": {
    "model_type": "reflow",
    "unet": {
      "unet_impl": "hf_diffusers",
      "spatial_dims": 2,
      "sample_size": 256,
      "in_channels": 1,
      "out_channels": 1,
      "center_input_sample": false,
      "time_embedding_type": "positional",
      "freq_shift": 0,
      "flip_sin_to_cos": true,
      "down_block_types": [
        "DownBlock2D",
        "DownBlock2D",
        "DownBlock2D",
        "DownBlock2D",
        "AttnDownBlock2D",
        "DownBlock2D"
      ],
      "up_block_types": [
        "UpBlock2D",
        "AttnUpBlock2D",
        "UpBlock2D",
        "UpBlock2D",
        "UpBlock2D",
        "UpBlock2D"
      ],
      "block_out_channels": [
        128,
        128,
        256,
        256,
        512,
        512
      ],
      "layers_per_block": 2,
      "downsample_padding": 1,
      "dropout": 0.0,
      "attention_head_dim": 8,
      "norm_num_groups": 32,
      "norm_eps": 1e-05,
      "resnet_time_scale_shift": "default",
      "add_attention": true
    },
    "scheduler": {
      "name": "flow_match_euler",
      "num_train_timesteps": 1000,
      "num_inference_steps": 10
    }
  },
  "training": {
    "epochs": 100,
    "batch_size": 16,
    "learning_rate": 0.0001,
    "weight_decay": 0.01,
    "lr_warmup_steps": 500,
    "lr_scheduler": {
      "name": "warmup_cosine"
    },
    "conditioning": "concatenate",
    "reflow_pairs_dir": "checkpoints/pixel_fm_concat_legacy/reflow_pairs",
    "use_amp": false,
    "seed": 42,
    "save_every": 1,
    "steps_per_epoch": 3125,
    "output_dir": "checkpoints/reflow_r1_concat_legacy",
    "data_root": "../DefaultDataset",
    "img_size": 256,
    "use_tensor_cache": true,
    "save_tensor_cache": true,
    "tensor_cache_subdir": "cache",
    "save_images": true,
    "save_images_every": 5
  },
  "dataset": {
    "conditioning": true,
    "target_key": "SDCT",
    "conditioning_key": "LDCT",
    "class": "datasets.ldct:LDCTDataset"
  }
}
